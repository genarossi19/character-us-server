DB_CONNECTION_STRING=postgresql://user:password@host:5432/database
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ISSUER=character-us-server
JWT_AUDIENCE=character-us-client
# Opcional: habilita POST /api/auth/google (cliente OAuth de tipo Web).
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.com
ADMIN_HASH=replace-with-bcrypt-hash
COOKIE_SECRET=replace-with-a-long-random-secret
# Lista separada por comas de los orígenes permitidos para HTTP y Socket.IO.
CORS_ORIGIN=http://localhost:5173,http://192.168.1.9:5173,https://characterus-front.onrender.com
